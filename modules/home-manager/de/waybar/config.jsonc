// -*- mode: jsonc -*-
{
  "layer": "top",
  "margin-top": 0,
  "margin-left": 0,
  "margin-bottom": 0,
  "margin-right": 0,
  "exclusive": true,
  "position": "top",
  "spacing": 3,

  "modules-left": ["custom/menu", "niri/workspaces", "niri/window" ],
  "modules-center": ["mpris","clock"],
  "modules-right": ["cpu", "memory", "temperature", "battery", "tray", "group/anln","custom/power-menu"],
  "group/anln": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "network",
      "custom/notification",
    ],
  },

  //获取屏幕颜色colorpicker
  //"custom/colorpicker": {
  //  "tooltip": false,
  //  "format": "󱏜",
  //  "on-click": "hyprpicker | wl-copy",
  //},
  
  //wf-recorder
  //"custom/wfrec": {
  //  "exec": "wf-recorder status-json",
  //  "return-type": "json",
  //  "interval": 1,                 // 每秒刷新一次
  //  "signal": 9,                   // 与脚本里的 WAYBAR_SIG 对应
  //  "tooltip": true,
  //  "on-click": "wf-recorder toggle",  // 左键：开始/停止
  //  "on-click-right": "wf-recorder stop"
  //},

  //多媒体
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": {
      "default": "",
    },
    "status-icons": {
      "paused": "",
    },
    "toooltip": "{dynamic}",
    "enable-tooltip-len-limits": true,
  },
  
  //音频可视化
  //"custom/cava": {
  //  "exec": "$HOME/.config/waybar/scripts/cava-waybar.sh",
  //  "return-type": "plain",
  //  "escape": false
  //},
  
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
    "critical-threshold": 80,
    "format": "{temperatureC}°C <span></span>",
    "format-alt": "{temperatureF}°F <span></span>",
    "tooltip-format": "Temperature: {temperatureC}°C",
    "on-click-right": "kitty btop"
   },
  
  "custom/power-menu": {
    "tooltip": true,
    "tooltip-format": "Power menu",
    "format": "<span> </span>",
    "on-click": "power-menu"
  },
  
  "custom/menu": {
    "format": "{icon}",
    "format-icons": "",
    "on-click" : "random-wallpaper",
    "on-click-right" : "rofi -show drun",
    "tooltip" : "true",
    "tooltip-format" : "Random Wallpaper"
  },

  "niri/window": {
    "format": "{app_id}",
    "separate-outputs": true,
    //"on-click": "nwg-bar",
    "on-click-right": "niri msg action close-window",
    "on-click-middle": "niri msg action switch-preset-window-width",
  },

  "niri/workspaces": {
    "disable-scroll": false,
    "on-click": "activate",
    "all-outputs": true,
    "active-only": true,
    "format": "{icon}",
    "format-icons": {
      "focused": "󰮯",
      "default": "󰊠",
      "empty": "",
    },
  },

  "tray": {
    "icon-size": 17,
    "spacing": 5,
  },

  "clock": {
    "interval": 1,
    "format": " {:%b %d %Y 󰥔 %H:%M:%S}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#ebdbb2'><b>{}</b></span>",
        "days": "<span color='#ebdbb2'><b>{}</b></span>",
        "weeks": "<span color='#ebdbb2'><b>W{}</b></span>",
        "weekdays": "<span color='#ebdbb2'><b>{}</b></span>",
        "today": "<span color='#d79921'><b>{}</b></span>",
      },
    },
  },

  "cpu": {
    "format": "{usage}% ",
    "on-click-right": "kitty btop"
  },

  "memory": {
    "format": "{}% ",
    "on-click-right": "kitty btop"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{capacity}% {icon}",
    "format-full": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-icons": {
      "default": ["", "", "", ""],
    },
    "format-muted": "",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 1,
    "tooltip-format": "{desc}\t{volume}%\t{icon}",
  },

  "network": {
    "format": "{icon}",
    "format-disconnected": "󰖪",
    "format-ethernet": "󰈀 /{ifname}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-linked": "󰖩",
    "format-wifi": "{icon}",
    "interval": 30,
    //"on-click": "nmgui",
    "on-click-right": "rfkill toggle wifi",
    "tooltip": true,
    "tooltip-format": "interface:\t{ifname}\nconnected to {essid} at {signalStrength}% strength",
    "tooltip-format-disconnected": "interface: {ifname}\nconnected to {essid}\nat {signalStrength}% strength",
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
}
