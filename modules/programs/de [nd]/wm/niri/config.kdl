// ============================================================
// niri 主配置（入口）
// ============================================================

// ============================================================
// 子配置
// ============================================================

include "./binds.kdl"          // 按键绑定
include "./environment.kdl"    // 环境变量
include "./noctalia-shell.kdl" // Noctalia Shell 集成
include "./recent-windows.kdl" // 最近窗口切换（Alt+Tab）
include "./patch.kdl"          // 补丁 / 特效配置
// include "./waybar.kdl"      // 旧 Waybar 配置（已弃用，改用 Noctalia）
include "./window-rule.kdl"    // 窗口规则

// ============================================================
// 输入设备
// ============================================================

input {
    keyboard {
        xkb {
            layout "us"
            options "grp:alt_shift_toggle,compose:ralt,ctrl:yescaps"
        }
        numlock
    }

    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        scroll-factor 0.3
        // scroll-factor vertical=1.0 horizontal=-2.0
        // scroll-method "two-finger"
        // scroll-button 273
        // scroll-button-lock
        // tap-button-map "left-middle-right"
        // click-method "clickfinger"
        // left-handed
        // disabled-on-external-mouse
        // middle-emulation
    }

    mouse {
        // off（关闭）
        // natural-scroll（自然滚动）
        // accel-speed 0.2（加速度）
        // accel-profile "flat"（加速度配置文件）
        // scroll-method "no-scroll"（滚动方法）
    }

    trackpoint {
        // off（关闭）
        // natural-scroll（自然滚动）
        // accel-speed 0.2（加速度）
        // accel-profile "flat"（加速度配置文件）
        // scroll-method "on-button-down"（滚动方法）
        // scroll-button 273（滚动按钮）
        // scroll-button-lock（滚动按钮锁定）
        // middle-emulation（中键模拟）
    }

    // warp-mouse-to-focus（将鼠标定位到焦点窗口）
    // focus-follows-mouse（焦点跟随鼠标）
    focus-follows-mouse max-scroll-amount="0%"
}

// ============================================================
// 输出（显示器）
// ============================================================

output "eDP-1" {
    mode "2520x1680@120.000"
    // transform "normal"（方向：normal / 90 / 180 / 270 / flipped / flipped-90 / flipped-180 / flipped-270）
    scale 1.75
    position x=0 y=0
    // focus-at-startup
}

// 备用外接显示器（已注释）
// output "HDMI-A-1" {
//     mode "1600x900@60.000"
//     // mode "1920x1080@60.000"
//     // mode "2560x1080@60.000"
//     position x=-1366 y=0
// }

// ============================================================
// 布局
// ============================================================

layout {
    // 窗口间隙（逻辑像素）
    gaps 8
    background-color "transparent"
    center-focused-column "never"

    // 预设列宽（可通过 Mod+R 切换）
    preset-column-widths {
        // 例如比例 0.25 可在一屏放置 4 个窗口；默认 1/3、1/2、2/3
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // 焦点环
    focus-ring {
        off
    }

    // 边框
    border {
        // off（关闭）
        width 2
        active-color "#DACDAA"
        inactive-color "#444C2E"
        urgent-color "#FB4934"
    }

    // 阴影
    shadow {
        on
        softness 15
        spread 2
        offset x=0 y=5
        color "#00000044"
    }
}

// 不使用客户端装饰（CSD）
prefer-no-csd

// 截图保存路径
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// 快捷键概览（启动时跳过）
hotkey-overlay {
    skip-at-startup
}

// 鼠标指针
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 20
}

// ============================================================
// 启动时运行的程序
// ============================================================
// 普通程序      → spawn-at-startup
// 后台守护进程  → spawn-sh-at-startup（命令需要 & 时使用）

spawn-sh-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1" // 权限认证代理
// spawn-sh-at-startup "glance --config ~/.config/glance/glance.yml &"         // glance 系统监控
spawn-at-startup "udiskie --automount --notify --smart-tray"                  // 磁盘挂载工具
spawn-at-startup "nm-applet"                                                  // 网络管理器 Applet
spawn-at-startup "poweralertd"                                                // 电源警报守护进程
spawn-at-startup "blueman-applet"                                             // 蓝牙 Applet
