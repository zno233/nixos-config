// ============================================================
// 全局窗口规则
// ============================================================

// 所有窗口统一：圆角、裁切、无边框背景
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    draw-border-with-background false
    // opacity 0.89
}

// ============================================================
// 浮动窗口
// ============================================================

// 通用浮动窗口
window-rule {
    // 计算器
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#

    // 系统工具 / 桌面门户
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^xdg-desktop-portal$"#
    match app-id=r#"^xdg-desktop-portal-gtk$"#
    match app-id=r#"^dynamic_power_user$"#
    match app-id=r#"^com\.network\.manager$"#

    // 音量控制
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^com\.saivert\.pwvucontrol$"#

    // 文件管理器
    match app-id=r#"^org\.gnome\.Nautilus$"#

    // 媒体播放器
    match app-id=r#"^mpv$"#
    match app-id=r#"^vlc$"#
    match app-id=r#"^imv$"#

    open-floating true
    // opacity 0.8
}

// 画中画 / 会议窗口
window-rule {
    match app-id=r#"firefox$"# title=r#"^Picture-in-Picture$"#
    match app-id=r#"^zoom$"#
    open-floating true
}

// ============================================================
// 整列显示（全屏）
// ============================================================

// 常用应用：打开时占满整列宽度
window-rule {
    // 浏览器
    match app-id=r#"^google-chrome$"#
    match app-id=r#"^chromium-browser$"#
    match app-id=r#"^brave-origin$"#

    // 编辑器 / IDE
    match app-id=r#"^code$"#
    match app-id=r#"^jetbrains-idea$"#
    match app-id=r#"^md\.Obsidian$"#
    match app-id=r#"^dev\.zed\.Zed$"#

    // 聊天
    match app-id=r#"^org\.telegram\.desktop$"#

    // 媒体 / 播放器
    match app-id=r#"^moe\.tsuna\.tsukimi$"#
    match app-id=r#"^SPlayer$"#
    match app-id=r#"^spotify$"#

    // 游戏
    match app-id=r#"^steam$"#

    // 其他
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    match app-id=r#"^electron$"#
    match app-id=r#"^pix$"#
    // match app-id=r#"^kitty$"#
    // match app-id=r#"^nemo$"#

    // 设置默认列宽度为 100%（占据整个屏幕）
    default-column-width { proportion 1.0; }

    // 如果你想要浮动窗口，保留这个
    // open-floating true

    // 如果你想要窗口占据整个屏幕高度，可以加上
    // default-window-height { proportion 1.0; }
}

// ============================================================
// 特殊窗口规则
// ============================================================

// wezterm：使用默认列宽
window-rule {
    // 尽量精确匹配，避免误伤其他窗口（可简化为 app-id="wezterm"）
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// GNOME 设置 / 网络连接编辑器：半屏宽、不浮动
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}

// Steam 通知弹窗：右下角、不抢焦点
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// QQ：浮动 + 75% 尺寸
window-rule {
    // match app-id=r#"^wechat$"#
    match app-id=r#"^QQ$"#
    open-floating true
    default-column-width { proportion 0.75; }
    default-window-height { proportion 0.75; }
}

// waydroid：禁止最大化
window-rule {
    match app-id=r#"^waydroid$"#
    // open-floating true
    open-maximized false
}

// SPlayer 桌面歌词：底部浮动
window-rule {
    match app-id=r#"^Splayer$"# title=r#"^桌面歌词$"#
    open-floating true
    default-column-width { proportion 0.75; }
    default-floating-position x=0 y=32 relative-to="bottom"
    border {
        off
    }
}

// waypaper：固定尺寸浮动
window-rule {
    match app-id=r#"^waypaper$"#
    default-window-height { fixed 660; }
    default-column-width { fixed 850; }
    open-floating true
    // opacity 0.8
}

// nemo "Open with" 对话框：固定尺寸浮动
window-rule {
    match app-id=r#"^nemo$"# title="Open with"
    open-floating true
    default-window-height { fixed 660; }
    default-column-width { fixed 850; }
}
