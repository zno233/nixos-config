include "./binds.kdl"
include "./environment.kdl"
include "./noctalia.kdl"
include "./recent-windows.kdl"
include "./patch.kdl"
// include "./waybar.kdl"
include "./window-rule.kdl"


input {
    keyboard {
        xkb {
            layout "us"
            options "grp:alt_shift_toggle,compose:ralt,ctrl:yescaps"
        }
        numlock
    }

    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // drag false
        // drag-lock
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        scroll-factor 0.3
        // scroll-factor vertical=1.0 horizontal=-2.0
        // scroll-method "two-finger"
        // scroll-button 273
        // scroll-button-lock
        // tap-button-map "left-middle-right"
        // click-method "clickfinger"
        // left-handed
        // disabled-on-external-mouse
        // middle-emulation
    }

    mouse {
        // off (关闭)
        // natural-scroll (自然滚动)
        // accel-speed 0.2 (加速度)
        // accel-profile "flat" (加速度配置文件)
        // scroll-method "no-scroll" (滚动方法)
    }

    trackpoint {
        // off (关闭)
        // natural-scroll (自然滚动)
        // accel-speed 0.2 (加速度)
        // accel-profile "flat" (加速度配置文件)
        // scroll-method "on-button-down" (滚动方法)
        // scroll-button 273 (滚动按钮)
        // scroll-button-lock (滚动按钮锁定)
        // middle-emulation (中键模拟)
    }

    // warp-mouse-to-focus (将鼠标定位到焦点窗口)
    // focus-follows-mouse (焦点跟随鼠标)
    focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-1" {
    mode "2520x1680@120.000"
    // normal, 90, 180, 270, flipped, flipped-90, flipped-180 and flipped-270. (方向)
    //transform "normal"
    scale 1.75
    position x=0 y=0
    //focus-at-startup
}

/-output "HDMI-A-1" {
   //mode "1920x1080@60.000"
    mode "1600x900@60.000"
   // mode "2560x1080@60.000"
    position x=-1366 y=0
}
layout {
    // Set gaps around windows in logical pixels. (设置窗口周围的间隙，以逻辑像素为单位。)
    gaps 8
    background-color "transparent"
    center-focused-column "never"

    preset-column-widths { // 你可以通过按 (Mod+R) 来更改列的宽度。
        // 例如，如果你设置比例为 "0.25"，你可以在屏幕上放置 4 个窗口。
        // 默认情况下是屏幕的 1/3, 1/2 和 2/3。
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        // off (关闭)
        width 2
        active-color "#DACDAA"
        inactive-color "#444C2E"
        urgent-color "#FB4934"
    }

    shadow {
        on
        softness 15
        spread 2
        offset x=0 y=5
        color "#00000044"
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

// 鼠标指针
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 20
}


// niri 启动时运行的程序
// 后台守护进程 (使用 spawn-sh-at-startup 启动需要 & 的服务)
// 普通启动程序 (使用 spawn-at-startup 启动)
//shared
spawn-sh-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1" // 权限认证代理
//spawn-sh-at-startup "glance --config ~/.config/glance/glance.yml &" //glance
spawn-at-startup "udiskie --automount --notify --smart-tray" // 磁盘挂载工具
spawn-at-startup "nm-applet"           // 网络管理器 Applet
spawn-at-startup "poweralertd"         // 电源警报守护进程
spawn-at-startup "blueman-applet"      // 蓝牙 Applet