// ============================================================
// Noctalia 背景模糊
// ============================================================

// 全区域模糊（不使用 xray）
// layer-rule {
//     match namespace=r#"^noctalia-(background|launcher-overlay|dock)-.*$"#
//     background-effect {
//         xray false
//     }
// }

// 关闭所有 Noctalia 表面的 xray，使模糊效果更真实
// （无需显式开启 blur，Noctalia 会自动应用）
layer-rule {
    match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel)$"#
    background-effect {
        xray false
        // blur false
    }
}

// ============================================================
// 模糊效果
// ============================================================

blur {
    passes 3        // 采样次数越多模糊越强（默认 3）
    offset 5.0      // 每次采样的距离（默认 3.0）
    noise 0.04      // 颗粒覆盖（默认 0.02）
    saturation 1.8  // 色彩饱和度增强（默认 1.5）
}

// ============================================================
// 窗口规则
// ============================================================

// 透明窗口背景模糊
window-rule {
    match app-id=r#"^kitty$"#
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    // match app-id=r#"^zen-beta$"#
    background-effect {
        blur true
        xray true
    }
}

// WPS Office 全屏（占满整列）
window-rule {
    match app-id=r#"^wpsoffice$"# title=r#"^WPS Office$"#

    // 设置默认列宽度为 100%（占据整个屏幕）
    default-column-width { proportion 1.0; }

    // 如果你想要浮动窗口，保留这个
    // open-floating true

    // 如果你想要窗口占据整个屏幕高度，可以加上
    // default-window-height { proportion 1.0; }
}

// 不透明窗口背景模糊（已注释）
// window-rule {
//     // match app-id=r#"^code$"#
//     // match app-id=r#"^electron$"#
//     // match app-id=r#"^obsidian$"#
//     // match app-id=r#"^org\.fooyin\.fooyin$"#
//     match app-id=r#"^kitty$"# title=r#"^hx$"#
//     // match app-id=r#"^jetbrains-idea$"#
//     opacity 0.95
//     background-effect {
//         blur true
//         xray true
//     }
// }

// Noctalia 设置窗口 / 桌面门户：浮动
window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"# title=r#"^Noctalia Settings$"#
    match app-id=r#"^xdg-desktop-portal-gtk"#
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.75; }
}

// splayer_next
window-rule {
    // 媒体 / 播放器
    match app-id=r#"^top.imsyy.splayer_next$"#

    // 设置默认列宽度为 100%（占据整个屏幕）
    default-column-width { proportion 1.0; }

    // 如果你想要浮动窗口，保留这个
    // open-floating true

    // 如果你想要窗口占据整个屏幕高度，可以加上
    // default-window-height { proportion 1.0; }
}
window-rule {
    match app-id=r#"^top.imsyy.splayer_next$"# title=r#"^SPlayer-Next - Desktop Lyric$"#
    open-floating true
    default-column-width { proportion 0.75; }
    default-floating-position x=0 y=32 relative-to="bottom"
    border {
        off
    }
}


// ============================================================
// 调试
// ============================================================

debug {
    // 允许 Noctalia 的通知操作与窗口激活
    honor-xdg-activation-with-invalid-serial
}