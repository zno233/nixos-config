include "glide.kdl"

binds {
    
}

window-rule { // blur for transparent windows

}
window-rule { // blur for opaque windows
    match app-id="^org.fooyin.fooyin$"
    opacity 0.95
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="nemo" title="Open with"
    open-floating true
    default-window-height {fixed 660; }
    default-column-width {fixed 850; }
}

window-rule { // 全屏
    match app-id="pix"
    
    // 设置默认列宽度为 100% (占据整个屏幕)
    default-column-width { proportion 1.0; }
    
    // 如果你想要浮动窗口，保留这个
    // open-floating true
    
    // 如果你想要窗口占据整个屏幕高度，可以加上
    // default-window-height { proportion 1.0; }
}